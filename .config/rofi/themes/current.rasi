configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "󰄲 Apps";
    display-run: "󰜎 Run";
    display-window: "󰖯 Windows";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";

    kb-row-up: "Up,Control+k";
    kb-row-down: "Down,Control+j";
    kb-accept-entry: "Return,KP_Enter";
    kb-remove-to-eol: "";
    kb-mode-next: "Shift+Right,Control+Tab,Alt+l";
    kb-mode-previous: "Shift+Left,Control+Shift+Tab,Alt+h";
    kb-remove-char-back: "BackSpace";
}

* {
    /* Catppuccin Mocha */
    bg:          #1e1e2e;
    bg-alt:      #181825;
    bg-selected: #313244;
    fg:          #cdd6f4;
    fg-alt:      #a6adc8;
    border:      #cba6f7;
    accent:      #b4befe;

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 580;
    background-color: @bg;
    border: 2px;
    border-color: @border;
    border-radius: 12px;
}

mainbox {
    padding: 16px;
    children: [inputbar, message, listview, mode-switcher];
}

inputbar {
    background-color: @bg-alt;
    border: 1px;
    border-color: @border;
    border-radius: 8px;
    padding: 10px 14px;
    spacing: 10px;
    children: [prompt, entry];
    margin: 0 0 12px 0;
}

prompt {
    text-color: @border;
    font-weight: bold;
}

entry {
    text-color: @fg;
    placeholder: "Type to search...";
    placeholder-color: @fg-alt;
}

listview {
    lines: 7;
    columns: 1;
    spacing: 6px;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    spacing: 12px;
    children: [element-icon, element-text];
}

element-icon {
    size: 24px;
}

element-text {
    text-color: @fg;
    vertical-align: 0.5;
}

element selected {
    background-color: @bg-selected;
    text-color: @border;
}

element selected element-text {
    text-color: @border;
}

mode-switcher {
    spacing: 8px;
    margin: 12px 0 0 0;
}

button {
    padding: 8px 12px;
    background-color: @bg-alt;
    text-color: @fg-alt;
    border-radius: 8px;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @border;
    text-color: @bg;
}

message {
    padding: 8px;
    margin: 0 0 8px 0;
    border-radius: 8px;
    background-color: @bg-alt;
}

textbox {
    text-color: @fg;
}
